{
  "$schema" : "https://json-schema.org/draft/2020-12/schema",
  "$id" : "https://ivoa.net/dm/proposaldm.vo-dml.json",
  "title" : "Proposal",
  "description" : "A model to represent an application for observing time. The model is intended to express all of the concepts required to specify the scientific parameters of the application in sufficient detail to allow the proposal to be reviewed and allocated time. It does not cover all the technical detail of instrument setup that would be needed to actually schedule the observations, although the intention is that information about targets etc. could be automatically transferred to an observing system.",
  "type" : "object",
  "properties" : {
    "ProposalModel" : {
      "type" : "object",
      "properties" : {
        "refs" : {
          "type" : "object",
          "properties" : {
            "$comment" : "placeholder to make commas easier!",
            "organization" : {
              "type" : "array",
              "items" : {
                "anyOf" : [ {
                  "$ref" : "https://ivoa.net/dm/proposaldm.vo-dml.json#/$defs/Organization"
                }, {
                  "$ref" : "https://ivoa.net/dm/proposalManagement.vo-dml.json#/$defs/Observatory"
                }, {
                  "type" : "number"
                } ]
              }
            },
            "person" : {
              "type" : "array",
              "items" : {
                "anyOf" : [ {
                  "$ref" : "https://ivoa.net/dm/proposaldm.vo-dml.json#/$defs/Person"
                }, {
                  "type" : "number"
                } ]
              }
            },
            "abstractProposal" : {
              "type" : "array",
              "items" : {
                "anyOf" : [ {
                  "$ref" : "https://ivoa.net/dm/proposaldm.vo-dml.json#/$defs/AbstractProposal"
                }, {
                  "$ref" : "https://ivoa.net/dm/proposaldm.vo-dml.json#/$defs/ObservingProposal"
                }, {
                  "$ref" : "https://ivoa.net/dm/proposalManagement.vo-dml.json#/$defs/SubmittedProposal"
                }, {
                  "type" : "number"
                } ]
              }
            }
          },
          "additionalProperties" : false
        },
        "abstractProposal" : {
          "type" : "array",
          "items" : {
            "$ref" : "https://ivoa.net/dm/proposaldm.vo-dml.json#/$defs/AbstractProposal"
          }
        }
      },
      "additionalProperties" : false
    }
  },
  "$defs" : {
    "$comment" : "placeholder to make commas easier!",
    "WikiDataId" : {
      "type" : "string",
      "built-in" : "true"
    },
    "ProposalKind" : {
      "description" : "",
      "enum" : [ "Standard", "ToO", "Survey" ]
    },
    "InvestigatorKind" : {
      "description" : "",
      "enum" : [ "PI", "COI" ]
    },
    "TextFormats" : {
      "description" : "acceptable text formats for document submission",
      "enum" : [ "latex", "rst", "asciidoc" ]
    },
    "CalibrationTarget_intendedUse" : {
      "description" : "",
      "enum" : [ "Amplitude", "Atmospheric", "Bandpass", "Phase", "Pointing", "Focus", "Polarization", "Delay" ]
    },
    "CelestialPosition" : {
      "type" : "object",
      "description" : "a point on the celestial sphere",
      "properties" : {
        "$comment" : "placeholder to make commas easier!",
        "sourceCoordinates" : {
          "$ref" : "https://ivoa.net/dm/ADQLGeomDM-v1.vo-dml.json#/$defs/Point",
          "description" : "The actual position"
        },
        "referenceFrame" : {
          "type" : "string",
          "built-in" : "true",
          "description" : "the reference frame"
        },
        "equinox" : {
          "type" : "number",
          "built-in" : "true",
          "description" : "the equinox when needed - not for modern reference frames"
        }
      },
      "required" : [ "sourceCoordinates", "referenceFrame" ],
      "additionalProperties" : false
    },
    "SpectralWindowSetup" : {
      "type" : "object",
      "description" : "Science oriented definition of a spectral window.",
      "properties" : {
        "$comment" : "placeholder to make commas easier!",
        "start" : {
          "$ref" : "https://ivoa.net/dm/IVOA-v1.0.vo-dml.json#/$defs/RealQuantity",
          "description" : "The start of the spectral window"
        },
        "end" : {
          "$ref" : "https://ivoa.net/dm/IVOA-v1.0.vo-dml.json#/$defs/RealQuantity",
          "description" : "The end of the spectral window"
        },
        "spectralResolution" : {
          "$ref" : "https://ivoa.net/dm/IVOA-v1.0.vo-dml.json#/$defs/RealQuantity",
          "description" : "channel width"
        },
        "isSkyFrequency" : {
          "type" : "boolean",
          "built-in" : "true",
          "description" : "represents an observed frequency"
        },
        "polarization" : {
          "$ref" : "https://ivoa.net/dm/proposaldm.vo-dml.json#/$defs/coords.Polarization",
          "description" : "desired polarization"
        }
      },
      "required" : [ "start", "end", "isSkyFrequency", "polarization" ],
      "additionalProperties" : false
    },
    "AbstractProposal" : {
      "type" : "object",
      "description" : "base proposal",
      "properties" : {
        "$comment" : "placeholder to make commas easier",
        "@type" : {
          "type" : "string",
          "description" : "UType as type discriminator"
        },
        "title" : {
          "type" : "string",
          "built-in" : "true",
          "description" : "the proposal title"
        },
        "summary" : {
          "type" : "string",
          "built-in" : "true",
          "description" : "a short summary/abstract of the proposal"
        },
        "scientificJustification" : {
          "type" : "object",
          "$ref" : "https://ivoa.net/dm/proposaldm.vo-dml.json#/$defs/Justification"
        },
        "technicalJustification" : {
          "type" : "object",
          "$ref" : "https://ivoa.net/dm/proposaldm.vo-dml.json#/$defs/Justification"
        },
        "investigators" : {
          "type" : "array",
          "items" : {
            "$ref" : "https://ivoa.net/dm/proposaldm.vo-dml.json#/$defs/Investigator"
          }
        },
        "kind" : {
          "$ref" : "https://ivoa.net/dm/proposaldm.vo-dml.json#/$defs/ProposalKind",
          "description" : "the type of proposal"
        },
        "relatedProposals" : {
          "type" : "array",
          "items" : {
            "$ref" : "https://ivoa.net/dm/proposaldm.vo-dml.json#/$defs/RelatedProposal"
          }
        },
        "supportingDocuments" : {
          "type" : "array",
          "items" : {
            "$ref" : "https://ivoa.net/dm/proposaldm.vo-dml.json#/$defs/SupportingDocument"
          }
        },
        "targets" : {
          "type" : "array",
          "items" : {
            "anyOf" : [ {
              "$ref" : "https://ivoa.net/dm/proposaldm.vo-dml.json#/$defs/CelestialTarget"
            }, {
              "$ref" : "https://ivoa.net/dm/proposaldm.vo-dml.json#/$defs/SolarSystemTarget"
            } ]
          }
        },
        "fields" : {
          "type" : "array",
          "items" : {
            "anyOf" : [ {
              "$ref" : "https://ivoa.net/dm/proposaldm.vo-dml.json#/$defs/TargetField"
            }, {
              "$ref" : "https://ivoa.net/dm/proposaldm.vo-dml.json#/$defs/SinglePointing"
            } ]
          }
        },
        "technicalGoals" : {
          "type" : "array",
          "items" : {
            "$ref" : "https://ivoa.net/dm/proposaldm.vo-dml.json#/$defs/TechnicalGoal"
          }
        },
        "observations" : {
          "type" : "array",
          "items" : {
            "anyOf" : [ {
              "$ref" : "https://ivoa.net/dm/proposaldm.vo-dml.json#/$defs/TargetObservation"
            }, {
              "$ref" : "https://ivoa.net/dm/proposaldm.vo-dml.json#/$defs/CalibrationObservation"
            } ]
          }
        },
        "_id" : {
          "type" : "integer",
          "description" : "surrogate key"
        }
      },
      "required" : [ "@type", "title", "summary", "scientificJustification", "technicalJustification", "investigators", "kind", "technicalGoals", "observations" ]
    },
    "ObservingProposal" : {
      "allOf" : [ {
        "$ref" : "https://ivoa.net/dm/proposaldm.vo-dml.json#/$defs/AbstractProposal"
      }, {
        "type" : "object",
        "description" : "a complete proposal",
        "properties" : {
          "$comment" : "placeholder to make commas easier"
        },
        "required" : [ ]
      } ],
      "unevaluatedProperties" : false
    },
    "RelatedProposal" : {
      "type" : "object",
      "description" : "a related proposal",
      "properties" : {
        "$comment" : "placeholder to make commas easier",
        "@type" : {
          "type" : "string",
          "description" : "UType as type discriminator"
        },
        "proposal" : {
          "oneOf" : [ {
            "type" : "number"
          }, {
            "$ref" : "https://ivoa.net/dm/proposaldm.vo-dml.json#/$defs/AbstractProposal"
          } ],
          "description" : "the related proposal"
        },
        "_id" : {
          "type" : "integer",
          "description" : "surrogate key"
        }
      },
      "required" : [ "proposal" ],
      "additionalProperties" : false
    },
    "Person" : {
      "type" : "object",
      "description" : "person connected with the proposal",
      "properties" : {
        "$comment" : "placeholder to make commas easier",
        "@type" : {
          "type" : "string",
          "description" : "UType as type discriminator"
        },
        "fullName" : {
          "type" : "string",
          "built-in" : "true",
          "description" : "The given names for the person"
        },
        "eMail" : {
          "type" : "string",
          "built-in" : "true",
          "description" : "an email that can be used to communicate with the person"
        },
        "homeInstitute" : {
          "oneOf" : [ {
            "type" : "number"
          }, {
            "$ref" : "https://ivoa.net/dm/proposaldm.vo-dml.json#/$defs/Organization"
          } ],
          "description" : ""
        },
        "orcidId" : {
          "type" : "string",
          "built-in" : "true",
          "description" : "orcid id see https://orcid.org"
        },
        "_id" : {
          "type" : "integer",
          "description" : "surrogate key"
        }
      },
      "required" : [ "fullName", "eMail", "homeInstitute" ],
      "additionalProperties" : false
    },
    "Investigator" : {
      "type" : "object",
      "description" : "",
      "properties" : {
        "$comment" : "placeholder to make commas easier",
        "@type" : {
          "type" : "string",
          "description" : "UType as type discriminator"
        },
        "person" : {
          "oneOf" : [ {
            "type" : "number"
          }, {
            "$ref" : "https://ivoa.net/dm/proposaldm.vo-dml.json#/$defs/Person"
          } ],
          "description" : "the investigator"
        },
        "type" : {
          "$ref" : "https://ivoa.net/dm/proposaldm.vo-dml.json#/$defs/InvestigatorKind",
          "description" : "the investigator type"
        },
        "forPhD" : {
          "type" : "boolean",
          "built-in" : "true",
          "description" : "is the investigator making proposal for their PhD"
        },
        "_id" : {
          "type" : "integer",
          "description" : "surrogate key"
        }
      },
      "required" : [ "person", "type" ],
      "additionalProperties" : false
    },
    "Organization" : {
      "type" : "object",
      "description" : "An institution that is a collection of people",
      "properties" : {
        "$comment" : "placeholder to make commas easier",
        "@type" : {
          "type" : "string",
          "description" : "UType as type discriminator"
        },
        "name" : {
          "type" : "string",
          "built-in" : "true",
          "description" : "The name of the organization"
        },
        "address" : {
          "type" : "string",
          "built-in" : "true",
          "description" : ""
        },
        "ivoid" : {
          "type" : "string",
          "format" : "uri",
          "description" : "the registry identifier for the organization"
        },
        "wikiId" : {
          "type" : "string",
          "built-in" : "true",
          "description" : "the wikidata id for the Organization"
        },
        "_id" : {
          "type" : "integer",
          "description" : "surrogate key"
        }
      },
      "required" : [ "@type", "name", "address" ]
    },
    "Justification" : {
      "type" : "object",
      "description" : "The justification for the proposal. Note that the justification is for reading by humans and is not parsed to extract things like source lists - that sort of information must be entered in the correct place in the model.",
      "properties" : {
        "$comment" : "placeholder to make commas easier",
        "@type" : {
          "type" : "string",
          "description" : "UType as type discriminator"
        },
        "text" : {
          "type" : "string",
          "built-in" : "true",
          "description" : "the full text of the justification"
        },
        "format" : {
          "$ref" : "https://ivoa.net/dm/proposaldm.vo-dml.json#/$defs/TextFormats",
          "description" : "the format of the text"
        },
        "_id" : {
          "type" : "integer",
          "description" : "surrogate key"
        }
      },
      "required" : [ "text", "format" ],
      "additionalProperties" : false
    },
    "SupportingDocument" : {
      "type" : "object",
      "description" : "a document",
      "properties" : {
        "$comment" : "placeholder to make commas easier",
        "@type" : {
          "type" : "string",
          "description" : "UType as type discriminator"
        },
        "title" : {
          "type" : "string",
          "built-in" : "true",
          "description" : "document title"
        },
        "location" : {
          "type" : "string",
          "format" : "uri",
          "description" : "location of document"
        },
        "_id" : {
          "type" : "integer",
          "description" : "surrogate key"
        }
      },
      "required" : [ "title", "location" ],
      "additionalProperties" : false
    },
    "Target" : {
      "type" : "object",
      "description" : "A target source",
      "properties" : {
        "$comment" : "placeholder to make commas easier",
        "@type" : {
          "type" : "string",
          "description" : "UType as type discriminator"
        },
        "sourceName" : {
          "type" : "string",
          "built-in" : "true",
          "description" : "A common name for the source"
        },
        "_id" : {
          "type" : "integer",
          "description" : "surrogate key"
        }
      },
      "required" : [ "@type", "sourceName" ]
    },
    "CelestialTarget" : {
      "allOf" : [ {
        "$ref" : "https://ivoa.net/dm/proposaldm.vo-dml.json#/$defs/Target"
      }, {
        "type" : "object",
        "description" : "The basic target setup for a celestial Target.",
        "properties" : {
          "$comment" : "placeholder to make commas easier",
          "coord" : {
            "$ref" : "https://ivoa.net/dm/proposaldm.vo-dml.json#/$defs/CelestialPosition",
            "description" : "the coordinates"
          },
          "coordUnit" : {
            "type" : "object",
            "properties" : {
              "value" : {
                "type" : "string"
              }
            },
            "description" : "the unit for the coordinates"
          },
          "positionEpoch" : {
            "type" : "number",
            "built-in" : "true",
            "description" : "the epoch at which the position was measured"
          },
          "pmRA" : {
            "$ref" : "https://ivoa.net/dm/IVOA-v1.0.vo-dml.json#/$defs/RealQuantity",
            "description" : ""
          },
          "pmDec" : {
            "$ref" : "https://ivoa.net/dm/IVOA-v1.0.vo-dml.json#/$defs/RealQuantity",
            "description" : ""
          },
          "parallax" : {
            "$ref" : "https://ivoa.net/dm/IVOA-v1.0.vo-dml.json#/$defs/RealQuantity",
            "description" : ""
          },
          "sourceVelocity" : {
            "$ref" : "https://ivoa.net/dm/IVOA-v1.0.vo-dml.json#/$defs/RealQuantity",
            "description" : ""
          }
        },
        "required" : [ "coord", "coordUnit", "positionEpoch" ]
      } ],
      "unevaluatedProperties" : false
    },
    "SolarSystemTarget" : {
      "allOf" : [ {
        "$ref" : "https://ivoa.net/dm/proposaldm.vo-dml.json#/$defs/Target"
      }, {
        "type" : "object",
        "description" : "",
        "properties" : {
          "$comment" : "placeholder to make commas easier"
        },
        "required" : [ ]
      } ],
      "unevaluatedProperties" : false
    },
    "Field" : {
      "type" : "object",
      "description" : "Definition of an observing field pointing",
      "properties" : {
        "$comment" : "placeholder to make commas easier",
        "@type" : {
          "type" : "string",
          "description" : "UType as type discriminator"
        },
        "name" : {
          "type" : "string",
          "built-in" : "true",
          "description" : ""
        },
        "_id" : {
          "type" : "integer",
          "description" : "surrogate key"
        }
      },
      "required" : [ "@type", "name" ]
    },
    "TargetField" : {
      "allOf" : [ {
        "$ref" : "https://ivoa.net/dm/proposaldm.vo-dml.json#/$defs/Field"
      }, {
        "type" : "object",
        "description" : "the field points to the associated target",
        "properties" : {
          "$comment" : "placeholder to make commas easier"
        },
        "required" : [ ]
      } ],
      "unevaluatedProperties" : false
    },
    "SinglePointing" : {
      "allOf" : [ {
        "$ref" : "https://ivoa.net/dm/proposaldm.vo-dml.json#/$defs/Field"
      }, {
        "type" : "object",
        "description" : "Single point on the sky",
        "properties" : {
          "$comment" : "placeholder to make commas easier",
          "centre" : {
            "$ref" : "https://ivoa.net/dm/proposaldm.vo-dml.json#/$defs/CelestialPosition",
            "description" : "Where to point"
          }
        },
        "required" : [ "centre" ]
      } ],
      "unevaluatedProperties" : false
    },
    "ObservingConstraint" : {
      "type" : "object",
      "description" : "a form of constraint on the observation",
      "properties" : {
        "$comment" : "placeholder to make commas easier",
        "@type" : {
          "type" : "string",
          "description" : "UType as type discriminator"
        },
        "_id" : {
          "type" : "integer",
          "description" : "surrogate key"
        }
      },
      "required" : [ "@type" ]
    },
    "TimingConstraint" : {
      "allOf" : [ {
        "$ref" : "https://ivoa.net/dm/proposaldm.vo-dml.json#/$defs/ObservingConstraint"
      }, {
        "type" : "object",
        "description" : "Any specific timing requirements for the observing",
        "properties" : {
          "$comment" : "placeholder to make commas easier",
          "note" : {
            "type" : "string",
            "built-in" : "true",
            "description" : ""
          },
          "isAvoidConstraint" : {
            "type" : "boolean",
            "built-in" : "true",
            "description" : ""
          }
        },
        "required" : [ ]
      } ]
    },
    "TimingWindow" : {
      "allOf" : [ {
        "$ref" : "https://ivoa.net/dm/proposaldm.vo-dml.json#/$defs/TimingConstraint"
      }, {
        "type" : "object",
        "description" : "particular time range",
        "properties" : {
          "$comment" : "placeholder to make commas easier",
          "startTime" : {
            "type" : "string",
            "format" : "date-time",
            "description" : ""
          },
          "endTime" : {
            "type" : "string",
            "format" : "date-time",
            "description" : ""
          }
        },
        "required" : [ ]
      } ],
      "unevaluatedProperties" : false
    },
    "SimultaneityConstraint" : {
      "allOf" : [ {
        "$ref" : "https://ivoa.net/dm/proposaldm.vo-dml.json#/$defs/TimingConstraint"
      }, {
        "type" : "object",
        "description" : "A constraint that requires that two observations occur simultaneously",
        "properties" : {
          "$comment" : "placeholder to make commas easier"
        },
        "required" : [ ]
      } ],
      "unevaluatedProperties" : false
    },
    "PointingConstaint" : {
      "allOf" : [ {
        "$ref" : "https://ivoa.net/dm/proposaldm.vo-dml.json#/$defs/ObservingConstraint"
      }, {
        "type" : "object",
        "description" : "A constraint that limits the telescope pointing",
        "properties" : {
          "$comment" : "placeholder to make commas easier"
        },
        "required" : [ ]
      } ],
      "unevaluatedProperties" : false
    },
    "ScienceSpectralWindow" : {
      "type" : "object",
      "description" : "A spectral window for science use.",
      "properties" : {
        "$comment" : "placeholder to make commas easier",
        "@type" : {
          "type" : "string",
          "description" : "UType as type discriminator"
        },
        "spectralWindowSetup" : {
          "$ref" : "https://ivoa.net/dm/proposaldm.vo-dml.json#/$defs/SpectralWindowSetup",
          "description" : ""
        },
        "expectedSpectralLine" : {
          "type" : "array",
          "items" : {
            "$ref" : "https://ivoa.net/dm/proposaldm.vo-dml.json#/$defs/ExpectedSpectralLine"
          }
        },
        "_id" : {
          "type" : "integer",
          "description" : "surrogate key"
        }
      },
      "required" : [ ],
      "additionalProperties" : false
    },
    "ExpectedSpectralLine" : {
      "type" : "object",
      "description" : "Brief description of a spectral line.",
      "properties" : {
        "$comment" : "placeholder to make commas easier",
        "@type" : {
          "type" : "string",
          "description" : "UType as type discriminator"
        },
        "restFrequency" : {
          "$ref" : "https://ivoa.net/dm/IVOA-v1.0.vo-dml.json#/$defs/RealQuantity",
          "description" : ""
        },
        "transition" : {
          "type" : "string",
          "built-in" : "true",
          "description" : ""
        },
        "splatalogId" : {
          "type" : "string",
          "built-in" : "true",
          "description" : ""
        },
        "description" : {
          "type" : "string",
          "built-in" : "true",
          "description" : ""
        },
        "_id" : {
          "type" : "integer",
          "description" : "surrogate key"
        }
      },
      "required" : [ "restFrequency", "splatalogId", "description" ],
      "additionalProperties" : false
    },
    "PerformanceParameters" : {
      "type" : "object",
      "description" : "The parameters required for observation to be useful for the science goal",
      "properties" : {
        "$comment" : "placeholder to make commas easier",
        "@type" : {
          "type" : "string",
          "description" : "UType as type discriminator"
        },
        "desiredAngularResolution" : {
          "$ref" : "https://ivoa.net/dm/IVOA-v1.0.vo-dml.json#/$defs/RealQuantity",
          "description" : ""
