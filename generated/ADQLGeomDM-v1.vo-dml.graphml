<?xml version="1.0" encoding="UTF-8"?>
<graphml xmlns="http://graphml.graphdrawing.org/xmlns/graphml"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://graphml.graphdrawing.org/xmlns http://www.yworks.com/xml/schema/graphml/1.0/ygraphml.xsd">
   <key xmlns:y="http://www.yworks.com/xml/graphml"
        attr.name="Title"
        attr.type="string"
        for="graph"
        id="t0">
      <default xml:space="preserve">adqlgeom</default>
   </key>
   <key xmlns:y="http://www.yworks.com/xml/graphml"
        attr.name="description"
        attr.type="string"
        for="node"
        id="k1"/>
   <key xmlns:y="http://www.yworks.com/xml/graphml"
        id="k2"
        for="node"
        yfiles.type="nodegraphics"/>
   <key xmlns:y="http://www.yworks.com/xml/graphml"
        id="k3"
        for="edge"
        yfiles.type="edgegraphics"/>
   <key xmlns:y="http://www.yworks.com/xml/graphml"
        id="k4"
        for="graph"
        yfiles.type="postprocessors"/>
   <graph edgedefault="directed"><!--nodes-->
      <node id="adqlgeom:Point">
         <data key="k1">Point</data>
         <data xmlns:y="http://www.yworks.com/xml/graphml" key="k2">
            <y:UMLClassNode>
               <y:Fill color="#BDB992" transparent="false"/>
               <y:BorderStyle color="#000000" type="line" width="1.0"/>
               <y:NodeLabel alignment="center" autoSizePolicy="content" fontFamily="Dialog" fontSize="12" fontStyle="bold" hasBackgroundColor="false" hasLineColor="false" horizontalTextPosition="center" iconTextGap="4" modelName="internal" modelPosition="c" textColor="#000000" verticalTextPosition="bottom" visible="true" xml:space="preserve" y="3.0">Point</y:NodeLabel>
               <y:UML clipContent="true"
                      constraint=""
                      hasDetailsColor="false"
                      omitDetails="false"
                      stereotype="dataType"
                      use3DEffect="true">
                  <y:AttributeLabel xml:space="preserve">+alpha : ivoa:real
+delta : ivoa:real
</y:AttributeLabel>
                  <y:MethodLabel xml:space="preserve"/>
               </y:UML>
            </y:UMLClassNode>
         </data>
      </node>
      <node id="adqlgeom:Line">
         <data key="k1">Line</data>
         <data xmlns:y="http://www.yworks.com/xml/graphml" key="k2">
            <y:UMLClassNode>
               <y:Fill color="#BDB992" transparent="false"/>
               <y:BorderStyle color="#000000" type="line" width="1.0"/>
               <y:NodeLabel alignment="center" autoSizePolicy="content" fontFamily="Dialog" fontSize="12" fontStyle="bold" hasBackgroundColor="false" hasLineColor="false" horizontalTextPosition="center" iconTextGap="4" modelName="internal" modelPosition="c" textColor="#000000" verticalTextPosition="bottom" visible="true" xml:space="preserve" y="3.0">Line</y:NodeLabel>
               <y:UML clipContent="true"
                      constraint=""
                      hasDetailsColor="false"
                      omitDetails="false"
                      stereotype="dataType"
                      use3DEffect="true">
                  <y:AttributeLabel xml:space="preserve">+begin : adqlgeom:Point
+end : adqlgeom:Point
</y:AttributeLabel>
                  <y:MethodLabel xml:space="preserve"/>
               </y:UML>
            </y:UMLClassNode>
         </data>
      </node>
      <node id="adqlgeom:Shape">
         <data key="k1">Shape</data>
         <data xmlns:y="http://www.yworks.com/xml/graphml" key="k2">
            <y:UMLClassNode>
               <y:Fill color="#BDB992" transparent="false"/>
               <y:BorderStyle color="#000000" type="line" width="1.0"/>
               <y:NodeLabel alignment="center" autoSizePolicy="content" fontFamily="Dialog" fontSize="12" fontStyle="bolditalic" hasBackgroundColor="false" hasLineColor="false" horizontalTextPosition="center" iconTextGap="4" modelName="internal" modelPosition="c" textColor="#000000" verticalTextPosition="bottom" visible="true" xml:space="preserve" y="3.0">Shape</y:NodeLabel>
               <y:UML clipContent="true"
                      constraint=""
                      hasDetailsColor="false"
                      omitDetails="false"
                      stereotype="dataType"
                      use3DEffect="true">
                  <y:AttributeLabel xml:space="preserve"/>
                  <y:MethodLabel xml:space="preserve"/>
               </y:UML>
            </y:UMLClassNode>
         </data>
      </node>
      <node id="adqlgeom:Circle">
         <data key="k1">Circle</data>
         <data xmlns:y="http://www.yworks.com/xml/graphml" key="k2">
            <y:UMLClassNode>
               <y:Fill color="#BDB992" transparent="false"/>
               <y:BorderStyle color="#000000" type="line" width="1.0"/>
               <y:NodeLabel alignment="center" autoSizePolicy="content" fontFamily="Dialog" fontSize="12" fontStyle="bold" hasBackgroundColor="false" hasLineColor="false" horizontalTextPosition="center" iconTextGap="4" modelName="internal" modelPosition="c" textColor="#000000" verticalTextPosition="bottom" visible="true" xml:space="preserve" y="3.0">Circle</y:NodeLabel>
               <y:UML clipContent="true"
                      constraint=""
                      hasDetailsColor="false"
                      omitDetails="false"
                      stereotype="dataType"
                      use3DEffect="true">
                  <y:AttributeLabel xml:space="preserve">+center : adqlgeom:Point
+radius : ivoa:real
</y:AttributeLabel>
                  <y:MethodLabel xml:space="preserve"/>
               </y:UML>
            </y:UMLClassNode>
         </data>
      </node>
      <node id="adqlgeom:Ellipse">
         <data key="k1">Ellipse</data>
         <data xmlns:y="http://www.yworks.com/xml/graphml" key="k2">
            <y:UMLClassNode>
               <y:Fill color="#BDB992" transparent="false"/>
               <y:BorderStyle color="#000000" type="line" width="1.0"/>
               <y:NodeLabel alignment="center" autoSizePolicy="content" fontFamily="Dialog" fontSize="12" fontStyle="bold" hasBackgroundColor="false" hasLineColor="false" horizontalTextPosition="center" iconTextGap="4" modelName="internal" modelPosition="c" textColor="#000000" verticalTextPosition="bottom" visible="true" xml:space="preserve" y="3.0">Ellipse</y:NodeLabel>
               <y:UML clipContent="true"
                      constraint=""
                      hasDetailsColor="false"
                      omitDetails="false"
                      stereotype="dataType"
                      use3DEffect="true">
                  <y:AttributeLabel xml:space="preserve">+major_axis : ivoa:real
+minor_axis : ivoa:real
+center : adqlgeom:Point
+pos_angle : ivoa:real
</y:AttributeLabel>
                  <y:MethodLabel xml:space="preserve"/>
               </y:UML>
            </y:UMLClassNode>
         </data>
      </node>
      <node id="adqlgeom:MultiShape">
         <data key="k1">MultiShape</data>
         <data xmlns:y="http://www.yworks.com/xml/graphml" key="k2">
            <y:UMLClassNode>
               <y:Fill color="#BDB992" transparent="false"/>
               <y:BorderStyle color="#000000" type="line" width="1.0"/>
               <y:NodeLabel alignment="center" autoSizePolicy="content" fontFamily="Dialog" fontSize="12" fontStyle="bold" hasBackgroundColor="false" hasLineColor="false" horizontalTextPosition="center" iconTextGap="4" modelName="internal" modelPosition="c" textColor="#000000" verticalTextPosition="bottom" visible="true" xml:space="preserve" y="3.0">MultiShape</y:NodeLabel>
               <y:UML clipContent="true"
                      constraint=""
                      hasDetailsColor="false"
                      omitDetails="false"
                      stereotype="dataType"
                      use3DEffect="true">
                  <y:AttributeLabel xml:space="preserve">+shapes : adqlgeom:Shape
</y:AttributeLabel>
                  <y:MethodLabel xml:space="preserve"/>
               </y:UML>
            </y:UMLClassNode>
         </data>
      </node>
      <node id="adqlgeom:Polygon">
         <data key="k1">Polygon</data>
         <data xmlns:y="http://www.yworks.com/xml/graphml" key="k2">
            <y:UMLClassNode>
               <y:Fill color="#BDB992" transparent="false"/>
               <y:BorderStyle color="#000000" type="line" width="1.0"/>
               <y:NodeLabel alignment="center" autoSizePolicy="content" fontFamily="Dialog" fontSize="12" fontStyle="bold" hasBackgroundColor="false" hasLineColor="false" horizontalTextPosition="center" iconTextGap="4" modelName="internal" modelPosition="c" textColor="#000000" verticalTextPosition="bottom" visible="true" xml:space="preserve" y="3.0">Polygon</y:NodeLabel>
               <y:UML clipContent="true"
                      constraint=""
                      hasDetailsColor="false"
                      omitDetails="false"
                      stereotype="dataType"
                      use3DEffect="true">
                  <y:AttributeLabel xml:space="preserve">+points : adqlgeom:Point
</y:AttributeLabel>
                  <y:MethodLabel xml:space="preserve"/>
               </y:UML>
            </y:UMLClassNode>
         </data>
      </node>
      <node id="adqlgeom:Box">
         <data key="k1">Box</data>
         <data xmlns:y="http://www.yworks.com/xml/graphml" key="k2">
            <y:UMLClassNode>
               <y:Fill color="#BDB992" transparent="false"/>
               <y:BorderStyle color="#000000" type="line" width="1.0"/>
               <y:NodeLabel alignment="center" autoSizePolicy="content" fontFamily="Dialog" fontSize="12" fontStyle="bold" hasBackgroundColor="false" hasLineColor="false" horizontalTextPosition="center" iconTextGap="4" modelName="internal" modelPosition="c" textColor="#000000" verticalTextPosition="bottom" visible="true" xml:space="preserve" y="3.0">Box</y:NodeLabel>
               <y:UML clipContent="true"
                      constraint=""
                      hasDetailsColor="false"
                      omitDetails="false"
                      stereotype="dataType"
                      use3DEffect="true">
                  <y:AttributeLabel xml:space="preserve">+pos_sw : adqlgeom:Point
+pos_ne : adqlgeom:Point
</y:AttributeLabel>
                  <y:MethodLabel xml:space="preserve"/>
               </y:UML>
            </y:UMLClassNode>
         </data>
      </node>
      <node id="adqlgeom:Interval">
         <data key="k1">Interval</data>
         <data xmlns:y="http://www.yworks.com/xml/graphml" key="k2">
            <y:UMLClassNode>
               <y:Fill color="#BDB992" transparent="false"/>
               <y:BorderStyle color="#000000" type="line" width="1.0"/>
               <y:NodeLabel alignment="center" autoSizePolicy="content" fontFamily="Dialog" fontSize="12" fontStyle="bold" hasBackgroundColor="false" hasLineColor="false" horizontalTextPosition="center" iconTextGap="4" modelName="internal" modelPosition="c" textColor="#000000" verticalTextPosition="bottom" visible="true" xml:space="preserve" y="3.0">Interval</y:NodeLabel>
               <y:UML clipContent="true"
                      constraint=""
                      hasDetailsColor="false"
                      omitDetails="false"
                      stereotype="dataType"
                      use3DEffect="true">
                  <y:AttributeLabel xml:space="preserve">+lower : ivoa:real
+upper : ivoa:real
</y:AttributeLabel>
                  <y:MethodLabel xml:space="preserve"/>
               </y:UML>
            </y:UMLClassNode>
         </data>
      </node>
      <!--imported nodes-->
      <!--edges-->
      <edge xmlns:y="http://www.yworks.com/xml/graphml"
            id="d434e68"
            source="adqlgeom:Circle"
            target="adqlgeom:Shape">
         <data key="k3">
            <y:PolyLineEdge>
               <y:LineStyle color="#FF0000" type="line" width="2.0"/>
               <y:Arrows source="none" target="white_delta"/>
               <y:BendStyle smoothed="false"/>
            </y:PolyLineEdge>
         </data>
      </edge>
      <edge xmlns:y="http://www.yworks.com/xml/graphml"
            id="d434e92"
            source="adqlgeom:Ellipse"
            target="adqlgeom:Shape">
         <data key="k3">
            <y:PolyLineEdge>
               <y:LineStyle color="#FF0000" type="line" width="2.0"/>
               <y:Arrows source="none" target="white_delta"/>
               <y:BendStyle smoothed="false"/>
            </y:PolyLineEdge>
         </data>
      </edge>
      <edge xmlns:y="http://www.yworks.com/xml/graphml"
            id="d434e147"
            source="adqlgeom:Polygon"
            target="adqlgeom:Shape">
         <data key="k3">
            <y:PolyLineEdge>
               <y:LineStyle color="#FF0000" type="line" width="2.0"/>
               <y:Arrows source="none" target="white_delta"/>
               <y:BendStyle smoothed="false"/>
            </y:PolyLineEdge>
         </data>
      </edge>
      <edge xmlns:y="http://www.yworks.com/xml/graphml"
            id="d434e162"
            source="adqlgeom:Box"
            target="adqlgeom:Shape">
         <data key="k3">
            <y:PolyLineEdge>
               <y:LineStyle color="#FF0000" type="line" width="2.0"/>
               <y:Arrows source="none" target="white_delta"/>
               <y:BendStyle smoothed="false"/>
            </y:PolyLineEdge>
         </data>
      </edge>
      <data xmlns:y="http://www.yworks.com/xml/graphml" key="k4">
         <y:Postprocessors>
            <y:Processor class="yext.graphml.processor.NodeSizeAdapter">
               <y:Option name="IGNORE_WIDTHS" value="false"/>
               <y:Option name="IGNORE_HEIGHTS" value="false"/>
               <y:Option name="ADAPT_TO_MAXIMUM_NODE" value="false"/>
            </y:Processor>
            <y:Processor class="y.module.TreeLayoutModule">
               <y:Option name="GENERAL.LAYOUT_STYLE" value="AR"/>
               <y:Option name="AR.BEND_DISTANCE" value="20"/>
               <y:Option name="AR.VERTICAL_SPACE" value="10"/>
               <y:Option name="AR.ASPECT_RATIO" value="1.41"/>
               <y:Option name="AR.HORIZONTAL_SPACE" value="10"/>
               <y:Option name="AR.USE_VIEW_ASPECT_RATIO" value="true"/>
            </y:Processor>
         </y:Postprocessors>
      </data>
   </graph>
</graphml>
